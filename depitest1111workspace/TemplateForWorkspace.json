		"workspaceName": {
			"type": "string",
			"metadata": "Workspace name",
			"defaultValue": "depitest1111workspace"
		},
		"depitest1111workspace-WorkspaceDefaultSqlServer_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'depitest1111workspace-WorkspaceDefaultSqlServer'",
			"defaultValue": "Integrated Security=False;Encrypt=True;Connection Timeout=30;Data Source=tcp:depitest1111workspace.sql.azuresynapse.net,1433;Initial Catalog=@{linkedService().DBName}"
		},
		"depitest1111workspace-WorkspaceDefaultStorage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://depitest1111.dfs.core.windows.net"
		}
	},
