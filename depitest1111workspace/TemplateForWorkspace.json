		{
			"name": "[concat(parameters('workspaceName'), '/personal_digital_twin_report')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "SELECT \n    d.department_name,\n    e.employee_name,\n    SUM(da.planned_tasks) AS total_planned_tasks,\n    SUM(da.completed_tasks) AS total_completed_tasks,\n    ROUND(AVG(da.sleep_duration_hours), 2) AS avg_sleep,\n    ROUND(AVG(da.productivity_score), 2) AS avg_productivity\nFROM DAILY_ACTIVITY da\nJOIN EMPLOYEE e \n    ON da.employee_id = e.employee_id\nJOIN DEPARTMENT d \n    ON e.department_id = d.department_id\nGROUP BY \n    d.department_name, \n    e.employee_name\nORDER BY \n    d.department_name, \n    avg_productivity DESC;",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "DedicatedSQLpool",
						"poolName": "DedicatedSQLpool"
					},
					"resultLimit": -1
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/warehouse')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "CREATE SCHEMA dw;\nGO\n\nCREATE TABLE dw.DIM_DEPARTMENT (\n    department_id   INT          NOT NULL,\n    department_name VARCHAR(50)  NOT NULL\n)\nWITH (DISTRIBUTION = REPLICATE, CLUSTERED INDEX (department_id));\nALTER TABLE dw.DIM_DEPARTMENT ADD CONSTRAINT PK_DIM_DEPARTMENT\n    PRIMARY KEY NONCLUSTERED (department_id) NOT ENFORCED;\n\nCREATE TABLE dw.DIM_EMPLOYEE (\n    employee_id     VARCHAR(10)  NOT NULL,\n    employee_name   VARCHAR(50)  NOT NULL,\n    department_id   INT          NOT NULL\n)\nWITH (DISTRIBUTION = REPLICATE, CLUSTERED INDEX (employee_id));\nALTER TABLE dw.DIM_EMPLOYEE ADD CONSTRAINT PK_DIM_EMPLOYEE\n    PRIMARY KEY NONCLUSTERED (employee_id) NOT ENFORCED;\n\nCREATE TABLE dw.DIM_DATE (\n    [date]       DATE        NOT NULL,\n    day_of_week  VARCHAR(10) NOT NULL,\n    is_weekend   TINYINT     NOT NULL\n)\nWITH (DISTRIBUTION = REPLICATE, CLUSTERED INDEX ([date]));\nALTER TABLE dw.DIM_DATE ADD CONSTRAINT PK_DIM_DATE\n    PRIMARY KEY NONCLUSTERED ([date]) NOT ENFORCED;\n\nCREATE TABLE dw.FACT_DAILY_ACTIVITY (\n    employee_id            VARCHAR(10)  NOT NULL,\n    [date]                 DATE         NOT NULL,\n    sleep_duration_hours   DECIMAL(4,1) NOT NULL,\n    work_duration_hours    DECIMAL(4,1) NOT NULL,\n    physical_activity_min  SMALLINT     NOT NULL,\n    screen_time_hours      DECIMAL(4,1) NOT NULL,\n    planned_tasks          SMALLINT     NOT NULL,\n    completed_tasks        SMALLINT     NOT NULL,\n    task_completion_rate   DECIMAL(5,2) NOT NULL,\n    productivity_score     TINYINT      NOT NULL\n)\nWITH (DISTRIBUTION = HASH(employee_id), CLUSTERED COLUMNSTORE INDEX);\nALTER TABLE dw.FACT_DAILY_ACTIVITY ADD CONSTRAINT PK_FACT_DAILY_ACTIVITY\n    PRIMARY KEY NONCLUSTERED (employee_id, [date]) NOT ENFORCED;\n\n\n\n\n\n\n\nCOPY INTO dw.DIM_DEPARTMENT\nFROM 'https://depitest1111.dfs.core.windows.net/depitest1111systemfile/personal digital twin/DEPARTMENT.csv'\nWITH (FILE_TYPE='CSV', FIRSTROW=2, CREDENTIAL=(IDENTITY='Managed Identity'));\n\nCOPY INTO dw.DIM_EMPLOYEE\nFROM 'https://depitest1111.dfs.core.windows.net/depitest1111systemfile/personal digital twin/EMPLOYEE.csv'\nWITH (FILE_TYPE='CSV', FIRSTROW=2, CREDENTIAL=(IDENTITY='Managed Identity'));\n\nCOPY INTO dw.DIM_DATE\nFROM 'https://depitest1111.dfs.core.windows.net/depitest1111systemfile/personal digital twin/DATE.csv'\nWITH (FILE_TYPE='CSV', FIRSTROW=2, CREDENTIAL=(IDENTITY='Managed Identity'));\n\nCOPY INTO dw.FACT_DAILY_ACTIVITY\nFROM 'https://depitest1111.dfs.core.windows.net/depitest1111systemfile/personal digital twin/DAILY_ACTIVITY.csv'\nWITH (FILE_TYPE='CSV', FIRSTROW=2, CREDENTIAL=(IDENTITY='Managed Identity'));\n",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "DedicatedSQLpool",
						"poolName": "DedicatedSQLpool"
					},
					"resultLimit": -1
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
